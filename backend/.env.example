# Configuração do backend do AnamneLab.
# Copie para backend/.env e ajuste. O .env fica fora do git: segredos só lá.

# ---------- IA de correção ----------
# falso: respostas determinísticas, sem rede (padrão, bom para desenvolver).
# anthropic: API da Anthropic (precisa de ANTHROPIC_API_KEY).
# gemini: API do Google, com plano grátis sem cartão (precisa de GEMINI_API_KEY, criada em
#   https://aistudio.google.com/apikey). Confira com: uv run python -m app.testar_ia
LLM_PROVEDOR=falso
# Só para o anthropic:
LLM_MODELO=claude-opus-5-5
# Esforço do modelo: low, medium, high, xhigh ou max.
LLM_ESFORCO=medium
# ANTHROPIC_API_KEY=
# Só para o gemini. Modelos em ordem: quando um esgota a cota grátis, tenta o próximo.
# GEMINI_API_KEY=
GEMINI_MODELOS=gemini-3.8-flash,gemini-3.5-flash,gemini-3.5-flash-lite
# Modelos que começam as tarefas simples (queixa, anamnese, sugestões), para sobrar cota dos
# melhores para separar as falas e corrigir. Vazio: todas as tarefas usam GEMINI_MODELOS.
GEMINI_MODELOS_LEVES=gemini-3.5-flash-lite
# Temperatura do Gemini (vazia: padrão do modelo). Com 0, duas correções da mesma conversa
# ficaram bem mais parecidas nos testes com o flash-lite.
GEMINI_TEMPERATURA=0

# ---------- Transcrição ----------
# falso: devolve a transcrição de exemplo (padrão).
# local: faster-whisper na máquina (instale com: uv pip install -e ".[local]").
# api: whisper-1 pela API (instale com: uv pip install -e ".[api]"; precisa de OPENAI_API_KEY).
TRANSCRICAO=falso
WHISPER_MODELO_LOCAL=small
# OPENAI_API_KEY=

# ---------- Banco e login ----------
# memoria: tudo some quando o servidor para (padrão). supabase: Postgres do Supabase.
BANCO=memoria
# dev: aluno fixo, sem login (padrão). supabase: confere o token do Supabase Auth.
AUTH=dev
# Necessários com BANCO=supabase ou AUTH=supabase (instale com: uv pip install -e ".[supabase]").
# SUPABASE_URL=https://<projeto>.supabase.co
# SUPABASE_SERVICE_KEY=

# ---------- Correção ----------
# true: checklist em rascunho entra na nota, marcada como provisória.
# false: só checklist aprovado (assinado pelo professor) conta.
CONTAR_RASCUNHO=true
# Máximo de itens por pedido de correção (0: cada checklist inteiro num pedido).
CORRECAO_ITENS_POR_PEDIDO=0

# ---------- Arquivos ----------
# Caminhos relativos partem da pasta backend/.
PASTA_CONTEUDO=../content
# Onde o áudio espera a transcrição (é apagado logo depois). Padrão: pasta temporária do sistema.
# PASTA_AUDIO_TEMP=/tmp/anamnelab-audio

# ---------- HTTP ----------
# Origens do frontend, separadas por vírgula.
CORS_ORIGENS=http://localhost:5173

# ---------- Limites do áudio ----------
DURACAO_MAXIMA_MIN=20
TAMANHO_MAXIMO_MB=25
