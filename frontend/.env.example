# Copie para .env.local e preencha. Nunca suba o .env para o git.

# Login pelo Supabase Auth (link mágico por e-mail).
# Deixe as duas vazias para o modo de desenvolvimento sem login
# (o backend precisa estar com AUTH=dev).
VITE_SUPABASE_URL=
# Chave pública (anon) do projeto. Não use a service_role aqui: tudo que começa
# com VITE_ vai para o navegador.
VITE_SUPABASE_ANON_KEY=

# Endereço da API. Vazio usa o proxy do Vite (/api -> http://localhost:8000).
# Preencha só quando o backend estiver em outro domínio.
VITE_API_URL=
